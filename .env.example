# Copy to .env (never commit .env). Every setting is optional; these are the defaults.

# Port the page is served on, and the interface to listen on. 127.0.0.1 is this machine only;
# docker-compose.yml sets 0.0.0.0 inside the container (its `ports` line decides who can reach it).
# PORT=8480
# HOST=127.0.0.1

# Folder with the record: sessions.csv, games.csv and next.json (see README). The site only reads it.
# DATA_DIR=data

# The page's heading, e.g. your community's name.
# TITLE=Game night history

# IANA timezone of the sessions: decides what "today" is ("16 months ago", whether next.json is current).
# TIMEZONE=America/Los_Angeles

# Host names the page may be opened under, besides IP addresses and localhost (comma-separated),
# e.g. nas.local or a domain behind a reverse proxy.
# ALLOWED_HOSTS=

# Development: re-read the page's own files on every request (`npm run dev` sets it).
# RELOAD=1

# docker-compose.yml only: the folder on the host with the record, mounted read-only. On a NAS,
# point it at the bot's history folder (an absolute path).
# RECORD_DIR=./data

# Cloudflare Tunnel token, for the optional `tunnel` service in docker-compose.yml (see the README).
# Secret: keep this file readable by you only.
# TUNNEL_TOKEN=
